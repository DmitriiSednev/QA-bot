# Плохой пример: инструмент напрямую подключается к БД

# agent/tools/add_faq_bad.py
import psycopg2
import os
from langchain.tools import BaseTool

class AddFAQToolBad(BaseTool):
    name = "add_faq_bad"
    description = "Bad example: tool connects directly."

    def _run(self, question: str, answer: str):
        conn = None
        try:
            # Прямое подключение в инструменте - ПЛОХО!
            conn = psycopg2.connect(
                host=os.getenv("DB_HOST"), 
                database=os.getenv("DB_NAME"),
                user=os.getenv("DB_USER"),
                password=os.getenv("DB_PASS")
            )
            cur = conn.cursor()
            # Небезопасный запрос - ПЛОХО!
            cur.execute(f"INSERT INTO faqs (question, answer) VALUES ('{question}', '{answer}')")
            conn.commit()
            cur.close()
            return "Added maybe?"
        except Exception as e:
            return f"Error: {e}"
        finally:
            if conn is not None:
                conn.close()
