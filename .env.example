# LLM Configuration
# Using OpenAI-compatible provider or OpenAI directly
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_BASE=YOUR_OPENAI_API_BASE_URL_IF_NEEDED

# Database Configuration (Example using DATABASE_URL for Supabase/Postgres)
# If using individual components, uncomment and fill these:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_NAME=
# If using a single connection string:
DATABASE_URL=postgresql://user:password@host:port/database

# Telegram Bot Token (Fill this in)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN